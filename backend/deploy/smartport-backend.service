# systemd 서비스 — 운영 EC2 에서 uvicorn 을 띄운다.
# 설치: sudo cp deploy/smartport-backend.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now smartport-backend
# 사용자·경로가 다르면 User / WorkingDirectory / ExecStart 를 고친다.
[Unit]
Description=SmartPort backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/backend
# 설정은 앱이 backend/.env 를 직접 읽는다(app/config.py). EnvironmentFile 은 쓰지 않는다.
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
# workers 는 반드시 1 — 입항 판정 잡(watch_arrivals)이 프로세스 안에서 돌아 워커 수만큼 중복 실행된다.
# 127.0.0.1 에만 연다. 외부 노출은 앞단 nginx 가 한다(deploy/README.md).
ExecStart=/home/ubuntu/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
