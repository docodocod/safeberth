# 로컬 개발 설정 — backend/.env 로 복사해서 쓴다.
# 운영 서버에 넣을 값은 .env.prod.example 참고. 설정 파일은 기계마다 .env 하나다.

# ── 로컬 인프라 (docker compose -f docker-compose.dev.yml up -d) ──────────
# POSTGRES_* · NEO4J_USER/NEO4J_PASSWORD 는 docker compose 가 컨테이너를 만들 때도 읽는다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 호스트 포트는 5432 가 아니라 5433
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5433/<db>
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── LLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER: gemini | openai
LLM_PROVIDER=openai
# [2026-09-29] nano → mini: 종합 문장이 입력 라벨("[등급 이유]")을 옮겨 적고(24/64) 확인할 항목을 빠뜨렸다(18/62). mini 는 0건, 속도는 판정 1건 +1.5초.
LLM_MODEL=gpt-4.1-mini
# 챗봇만 쓰는 모델(같은 provider). 비우면 LLM_MODEL. 도구를 고르는 에이전트라 nano 로는 불안정하다.
CHATBOT_LLM_MODEL=gpt-4.1-mini
# 화물 혼재 심사(/safety/assess)만 쓰는 모델. 비우면 LLM_MODEL. 서술(화물 특성·체크리스트)만 LLM 이라 nano 로 충분.
SAFETY_LLM_MODEL=gpt-4.1-nano

# ── 공공 API ───────────────────────────────────────────────────────────────
KMA_API_KEY=
KOSHA_API_KEY=
PORT_MIS_API_KEY=
MOF_API_KEY=

# ── 하역 개시 인터락 게이트 (MQTT) ─────────────────────────────────────────
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# ── 동작 ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# ENVIRONMENT 는 생략(=dev). 운영 서버의 .env 에만 ENVIRONMENT=prod
# 쉼표 구분. 개발은 * 허용
CORS_ORIGINS=*
ENABLE_SCHEDULER=true
