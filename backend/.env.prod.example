# 운영 서버(backend EC2)의 backend/.env 에 넣을 값.
#
# 사용법: 로컬에서 이 파일을 backend/.env.prod 로 복사해 값을 채워 보관하고
#         (.env.prod 는 git 에 올라가지 않고, 코드도 읽지 않는다), 배포할 때 서버의
#         backend/.env 에 이 내용을 넣는다. 파일 이름은 서버에서도 .env 다.
#         윈도우에서 만든 내용이면 서버에서 줄끝을 정리한다:
#           sed -i 's/\r$//' .env && chmod 600 .env

# 운영 검사를 켠다(CORS_ORIGINS='*' 면 기동 실패). 로컬 .env 에는 적지 않는다.
ENVIRONMENT=prod

# ── RDS PostgreSQL ─────────────────────────────────────────────────────────
# RDS 에 vector · btree_gist 확장이 필요하다(alembic 0006 · 0010).
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<rds-endpoint>:5432/<db>

# ── Neo4j Aura ─────────────────────────────────────────────────────────────
# 2026-09-24 이전 개발 .env 에 들어 있던 Aura 값 3줄을 그대로 옮기면 된다.
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_USER=
NEO4J_PASSWORD=

# ── LLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-nano
# 챗봇만 쓰는 모델(같은 provider). 비우면 LLM_MODEL. 도구를 고르는 에이전트라 nano 로는 불안정하다.
CHATBOT_LLM_MODEL=gpt-4.1-mini

# ── 공공 API ───────────────────────────────────────────────────────────────
KMA_API_KEY=
KOSHA_API_KEY=
PORT_MIS_API_KEY=
MOF_API_KEY=

# ── 하역 개시 인터락 게이트 (MQTT) ─────────────────────────────────────────
# 운영에서 브로커를 어디에 둘지는 미정. 브로커가 없어도 앱은 뜬다.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# ── 동작 ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# 운영에서는 * 금지(기동 시 오류). frontend 를 같은 도메인 nginx 뒤에 두면 비워 둔다.
CORS_ORIGINS=
ENABLE_SCHEDULER=true
