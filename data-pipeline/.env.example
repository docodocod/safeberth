# ════════════════════════════════════════════════════════════════════════════
# data-pipeline 설정 — 로컬 개발용. 이 파일을 data-pipeline/.env 로 복사해서 쓴다.
#
# 설정 파일은 **기계마다 .env 하나**다(backend 도 같다).
# 로컬 PC 는 dev 만, 수집 EC2 는 prod 만 돌리므로 그 기계의 .env 가 곧 그 환경이다.
#   · 로컬:  이 파일 → .env
#   · 운영:  .env.prod.example → 로컬에 .env.prod 로 값을 채워 보관 → 수집 EC2 의 .env 에 넣음
#
# .env 는 실행 위치가 아니라 코드 위치 기준으로 찾는다 — 서버 어디에 레포를 받든
# data-pipeline 폴더 바로 안에 두면 된다(python -m 실행 기준, 2026-09-24 실측).
#
# DB 접속은 DATABASE_URL 과 POSTGRES_* 를 **둘 다** 채운다. common_pg_loader 는
# DATABASE_URL 을 먼저 보지만, Neo4j 로더들(berth·imdg·bulk_compatibility)은
# POSTGRES_* 5개를 직접 읽는다. 둘 다 같은 DB 를 가리켜야 한다.
# 기본값은 없다 — 값이 빠지면 localhost 로 가지 않고 에러로 멈춘다.
# ════════════════════════════════════════════════════════════════════════════

# ── 울산항만공사 Open API ───────────────────────────────────────────────────
UPA_SERVICE_KEY=여기에_발급키_입력

# ── 공공데이터포탈 API 키 (디코딩된 값) ────────────────────────────────────
KOSHA_MSDS_API_KEY=여기에_디코딩된_API_키_입력
KHOA_API_KEY=여기에_KHOA_API_키_입력

# ── 기상청 APIHUB ───────────────────────────────────────────────────────────
KMA_BUOY_AUTH_KEY=여기에_기상청_APIHUB_인증키_입력

# ── 공공데이터포털 기상청 단기예보(getVilageFcst) — 풍속/파고 예보 ──────────
KMA_API_KEY=여기에_공공데이터포털_기상청_단기예보_디코딩키_입력

# ── 해양수산부 항만기상정보시스템 ───────────────────────────────────────────
MMAF_API_KEY=여기에_항만기상_API_키_입력

# ── 해양수산부 PORT-MIS 선박운항정보 (backend 설정의 PORT_MIS_API_KEY와 동일 값) ──
PORT_MIS_API_KEY=여기에_PORT_MIS_API_키_입력

# ── aisstream.io 실시간 AIS (레거시 — AIS 는 현재 수집하지 않는다. 비워도 됨) ──
AISSTREAM_API_KEY=여기에_aisstream_API_키_입력

# ── PostgreSQL (마스터 스테이징 DB) ────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5433/<db>
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=여기에_DB이름_입력
POSTGRES_USER=여기에_DB유저_입력
POSTGRES_PASSWORD=여기에_PG_비밀번호_입력

# ── Neo4j (지식 그래프 마스터 DB) — 로컬 docker compose ─────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=여기에_NEO4J_비밀번호_입력
NEO4J_DATABASE=neo4j
