# ════════════════════════════════════════════════════════════════════════════
# data-pipeline 설정 — 운영(수집 EC2)용.
#
# 사용법: 로컬에서 이 파일을 data-pipeline/.env.prod 로 복사해 값을 채워 보관하고
#         (.env.prod 는 git 에 올라가지 않는다), 서버에 올릴 때 이름을 .env 로 바꿔 넣는다.
#           scp -i <키.pem> .env.prod ubuntu@<수집EC2>:/home/ubuntu/data-pipeline/.env
#         윈도우에서 만든 파일은 줄끝이 CRLF 일 수 있다 — 서버에서 한 번 정리한다.
#           sed -i 's/\r$//' .env && chmod 600 .env
#
# 로컬 PC 에서는 이 레포가 .env 만 읽으므로 .env.prod 는 보관용일 뿐 아무 영향이 없다.
# DB 는 DATABASE_URL 과 POSTGRES_* 를 둘 다, 같은 RDS 로 채운다(.env.example 참고).
#
# (2026-09-24) 수집 EC2 가 RDS 에 바로 적재한다 — S3·cloud_pull 경로는 없앴다.
# raw 원본은 회차가 끝나면 지운다(data_pipeline/raw_cleanup.py). 서버 설정은 deploy/README.md.
# ════════════════════════════════════════════════════════════════════════════

# ── 공공 API 키 (로컬과 같은 키를 써도 된다) ────────────────────────────────
UPA_SERVICE_KEY=
KOSHA_MSDS_API_KEY=
KHOA_API_KEY=
KMA_BUOY_AUTH_KEY=
KMA_API_KEY=
MMAF_API_KEY=
PORT_MIS_API_KEY=

# ── PostgreSQL — AWS RDS ───────────────────────────────────────────────────
# RDS 보안그룹이 수집 EC2 를 허용해야 한다.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/<db>
POSTGRES_HOST=<rds-endpoint>
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Neo4j — Aura ───────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
